{
  "name": "bth-ui",
  "version": "0.0.3",
  "description": "Web components built with Stencil.js",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/bth-ui/bth-ui.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/bth-ui/bth-ui.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./docs.json": "./docs/docs.json",
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./package.json": "./package.json",
    "./tokens.json": "./docs/tokens.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pamelacfelipe/bth-ui.git"
  },
  "files": [
    "dist/",
    "docs/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build && node scripts/build-tokens.mjs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/sass": "^3.3.3",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "clsx": "^2.1.1",
    "playwright": "^1.52.0",
    "sass-embedded": "^1.105.1",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
